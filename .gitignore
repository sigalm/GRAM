.DS_Store

# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
# docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# raw ACS data (large files, not for publishing)
data/acs_data/raw/

# Analysis outputs (can be regenerated)
analyses/**/results/
analyses/**/*.RDS
analyses/**/*.rds

# Rendered notebook outputs (can be regenerated)
*.nb.html
calibration/*.html

# Word lock files
~$*

# Interim calibration grid results (regenerable; commit a final set with `git add -f`)
calibration/calibration_results_*.RDS

# Knitted supplements (regenerable from the .Rmd; the values in them are read from the
# model at knit time, so a working copy goes stale as soon as a parameter changes).
# When a supplement is actually submitted or circulated, commit that exact version with
# `git add -f` under a dated name, e.g. 01_natural_history_supplement_20260820.docx.
docs/*.docx
docs/*.pdf
docs/*.html
# Generated figures and plots (regenerable from the analysis scripts, and each set is
# stamped with the run id that produced it, so a tracked copy goes stale as soon as the
# model changes). When a set is actually submitted or circulated, commit that exact
# version with `git add -f`.
analyses/**/figures/
analyses/**/plots/

# Default device dump R writes when a plot is drawn headlessly
Rplots.pdf
